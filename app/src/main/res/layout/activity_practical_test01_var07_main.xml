<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".PracticalTest01Var07MainActivity">

    <!-- CERINȚĂ C1: Sa se creeze o interfata grafica ce contine 4 campuri text, editabile,
         dispuse intr-o tabela 2x2. In plus, va fi inclus si un buton Set, centrat pe
         orizontala, pe o alta linie. -->

    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:rowCount="2"
        android:columnCount="2"
        android:alignmentMode="alignBounds"
        android:columnOrderPreserved="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_default="spread">

        <!-- CERINȚĂ C2.c: android:freezesText="true" = SALVARE AUTOMATĂ a textului
             când activitatea este distrusă (ex: rotire ecran) -->

        <!-- CÂMPUL 1: Top-Left -->
        <EditText
            android:id="@+id/editTextTopLeft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:hint="Top Left"
            android:inputType="numberDecimal|numberSigned"
            android:minHeight="48dp"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:freezesText="true" />

        <!-- CÂMPUL 2: Top-Right -->
        <EditText
            android:id="@+id/editTextTopRight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:hint="Top Right"
            android:inputType="numberDecimal|numberSigned"
            android:minHeight="48dp"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:freezesText="true" />

        <!-- CÂMPUL 3: Bottom-Left -->
        <EditText
            android:id="@+id/editTextBottomLeft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:hint="Bottom Left"
            android:inputType="numberDecimal|numberSigned"
            android:minHeight="48dp"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:freezesText="true" />

        <!-- CÂMPUL 4: Bottom-Right -->
        <EditText
            android:id="@+id/editTextBottomRight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:hint="Bottom Right"
            android:inputType="numberDecimal|numberSigned"
            android:minHeight="48dp"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:freezesText="true" />

    </GridLayout>

    <!-- BUTONUL SET -->
    <Button
        android:id="@+id/buttonSet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Set"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/gridLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>